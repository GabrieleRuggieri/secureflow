# Same-origin via nginx (:80). Keycloak >= 26.0.1 works on Safari over HTTP localhost.
NEXT_PUBLIC_CORE_API_URL=http://localhost/core
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost/auth/realms/secureflow
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=secureflow-frontend
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost/oidc/callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_URI=http://localhost/
