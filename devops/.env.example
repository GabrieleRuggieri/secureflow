# SecureFlow - Environment variables for docker-compose
# Copy to project root as .env and adjust as needed. Never commit .env to Git.

# MySQL
MYSQL_ROOT_PASSWORD=secureflow_root
MYSQL_DATABASE=secureflow
MYSQL_USER=secureflow
MYSQL_PASSWORD=secureflow

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
