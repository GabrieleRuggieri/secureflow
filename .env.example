# SecureFlow - Environment variables for docker-compose
# Copy to .env and adjust as needed. Never commit .env to Git.
#
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=secureflow_root
MYSQL_DATABASE=secureflow
MYSQL_USER=secureflow
MYSQL_PASSWORD=secureflow

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Gateway ↔ Core M2M
SECUREFLOW_INTERNAL_TOKEN=secureflow-internal
